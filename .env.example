# ============================================================================
# FRONTEND (Vite) · Vercel → Settings → Environment Variables
# Son públicas por diseño: la seguridad la dan Supabase Auth + Row Level Security.
# ============================================================================
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ============================================================================
# SOLO SERVIDOR · NUNCA en variables VITE_ ni en el código del navegador
# ----------------------------------------------------------------------------
# Supabase Edge Functions: SUPABASE_URL, SUPABASE_ANON_KEY y
# SUPABASE_SERVICE_ROLE_KEY ya vienen cargadas automáticamente.
# Obligatoria (Fase 4, envíos programados de WhatsApp):
#   supabase secrets set CRON_SECRET=...   (la misma clave guardada en Vault como rf_cron_secret)
# Opcionales:
#   WHATSAPP_API_VERSION=v21.0
#   WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_TEMPLATE_LANG  (número de respaldo de la plataforma;
#   cada comercio conecta el suyo desde la app → queda en business_secrets)
#   MERCADOPAGO_ACCESS_TOKEN / MERCADOPAGO_WEBHOOK_SECRET
# Guía completa: docs/WHATSAPP-META.md
#
# Script de migración de usuarios (se corre una vez desde tu PC):
#   SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... node scripts/migrate-legacy-users.mjs
# ============================================================================

# Opcional (solo desarrollo local con server.ts):
GEMINI_API_KEY=""
APP_URL=""
